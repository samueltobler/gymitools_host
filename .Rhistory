m <- matrix(0, nrow = 6, ncol = 6, byrow = T)
for(i in 1:10){
for(person in 1:2){
# solange neue Zufallsposition ziehen, bis ein 0-Feld gefunden ist
repeat {
a <- sample(1:6, 1)
b <- sample(1:6, 1)
if (m[a, b] == 0) {
m[a, b] <- person
break           # Schleife verlassen, wenn erfolgreich gesetzt
}
}
}
}
cols <- c(
"0" = "white",
"1" = "beige",
"2" = "brown"
)
df <- expand.grid(
x = 1:ncol(m),
y = 1:nrow(m)
)
