coord_fixed() +
theme_minimal() +
theme(
axis.title = element_blank(),
panel.grid = element_blank()
)
for(person in 1:2){
a <- sample(1:6, 1)
b <- sample(1:6, 1)
print(person)
print(paste(a,b))
if (m[a, b] == 0) {
m[a, b] <- person
} else {if (person == 1) {
if (m[a, b] == 1) {
nachbarn <- rbind(
c(a + 1, b),
c(a - 1, b),
c(a, b + 1),
c(a, b - 1)
)
in_bounds <- nachbarn[,1] >= 1 & nachbarn[,1] <= nrow(m) &
nachbarn[,2] >= 1 & nachbarn[,2] <= ncol(m)
nachbarn <- nachbarn[in_bounds, , drop = FALSE]
freie <- apply(nachbarn, 1, function(idx) m[idx[1], idx[2]] == 0)
freie_nachbarn <- nachbarn[freie, , drop = FALSE]
if (nrow(freie_nachbarn) > 0) {
pos <- freie_nachbarn[sample(1:nrow(freie_nachbarn), 1), ]
m[pos[1], pos[2]] <- person
}
}
if (m[a,b] == 2) {
m[a, b] <- 2
}
}
if (person == 2) {
if (m[a,b] == 1) {
m[a, b] <- 2
}
if (m[a,b] == 2) {
m[a, b] <- 0
}
}
}
}
df <- expand.grid(
x = 1:ncol(m),
y = 1:nrow(m)
)
df$val <- as.vector(m)
ggplot(df, aes(x, y, fill = factor(val))) +
geom_tile(colour = "grey60") +
scale_fill_manual(values = cols, guide = "none") +
scale_x_continuous(breaks = 1:6) +
scale_y_reverse(breaks = 1:6) +
coord_fixed() +
theme_minimal() +
theme(
